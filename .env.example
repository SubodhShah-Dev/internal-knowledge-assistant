NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://app_user:local_dev_password@localhost:5432/knowledge_assistant
JWT_SECRET=replace_with_a_strong_secret
FRONTEND_ORIGIN=http://localhost:5173
UPLOAD_DIR=./apps/backend/uploads

# LLM provider (OpenAI-compatible; works with Groq, Google Gemini, OpenRouter, Cerebras, or local Ollama)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_MS=60000

MAX_UPLOAD_MB=10
